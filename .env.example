# Copy this file to .env and replace every placeholder. Never commit .env.

# Long random string, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-long-random-secret>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL only. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://booking_app:<app-role-password>@localhost:5432/booking

# Minutes a seat hold stays valid before it expires.
HOLD_TTL_MINUTES=10

# Shared secret used to sign and verify payment webhooks (HMAC-SHA256).
PAYMENT_WEBHOOK_SECRET=<generate-a-long-random-secret>

# Number of reverse proxies in front of the app (0 for direct connections). Throttling
# trusts X-Forwarded-For only this many hops deep.
NUM_PROXIES=0

# Production only: opt in to HSTS preloading once the domain is final.
SECURE_HSTS_PRELOAD=False
